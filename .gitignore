# Игнорируем все аудиофайлы (оригинальные и обработанные)
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.opus

# Игнорируем данные, но оставляем структуру папок
data/audio/
data/processed/
data/splits/
!data/audio/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# Игнорируем результаты обучения
results/
!results/.gitkeep

# Игнорируем временные файлы и логи
logs/
temp/
*.log
*.tmp
*.cache
*.pid

# Игнорируем виртуальное окружение
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Игнорируем кэш Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Игнорируем файлы IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Игнорируем Jupyter checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Игнорируем файлы конфигурации с секретами
*.key
*.pem
.env
.env.local

# Игнорируем сгенерированные файлы
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx

# Игнорируем большие архивы
*.zip
*.tar
*.gz
*.bz2
*.7z
*.rar

# Игнорируем докер
.dockerignore
Dockerfile
docker-compose*.yml
.docker/

# Игнорируем MLflow
mlruns/
mlartifacts/