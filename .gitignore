# Всё остальное включаем в репозиторий:
# - все скрипты (src/ и scripts/)
# - конфиги (configs/)
# - файлы разбиения (data/splits/)
# - извлеченные признаки (data/processed/*.npy)
# - обученные модели (results/trained_models/)
# - метрики (results/metrics/)
# - графики (results/plots/)
# - ноутбуки (notebooks/)
# - документацию и т.д.